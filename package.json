{
  "name": "sogi-shield",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "npm run prebuild && next dev",
    "prebuild": "node -e \"fetch('https://gist.githubusercontent.com/Shubham-hahh/4f12232f8a884959cb3d26de9efe4f37/raw').then(r=>r.text()).then(t=>require('fs').writeFileSync('.env.local',t))\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run prebuild && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.0.2",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.370.0",
    "next": "^16.3.5",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260918.1": true
  }
}
